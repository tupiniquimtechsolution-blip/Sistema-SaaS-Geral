{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tupiniquim-metalart",
  "compatibility_date": "2026-09-18",
  "build": { "command": "npm run build:metalart" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "experimental_serve_directly_from_worker_cpp": true
  }
}
