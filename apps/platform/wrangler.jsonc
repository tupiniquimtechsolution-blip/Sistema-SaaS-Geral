{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tupiniquim-saas",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "npm run build:platform",
    "cwd": "../.."
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
