{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tupiniquim-site-builder",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "build": {
    "command": "npm run build:builder",
    "cwd": "../.."
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
