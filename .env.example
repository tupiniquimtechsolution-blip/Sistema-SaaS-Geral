# Browser-safe Supabase configuration (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tenant/domain resolution
APP_BASE_DOMAIN=localhost
VITE_APP_BASE_DOMAIN=localhost

# Billing provider (server-only unless explicitly marked VITE_)
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Messaging/integration providers (server-only)
WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=

# Optional observability providers
SENTRY_DSN=
VITE_SENTRY_DSN=

# Never commit real .env files. Vercel/Supabase production secrets must be stored in provider environment/secret management.
